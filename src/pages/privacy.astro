---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="Privacy" description={`How ${SITE.name} handles your data: almost not at all.`}>
  <section class="page-head wrap">
    <h1><span class="over" data-echo="Privacy">Privacy</span></h1>
    <p>No accounts, no cookies, and what you type stays in your browser.</p>
  </section>
  <section class="prose wrap">
    <h2>What you type</h2>
    <p>Topics, scripts and descriptions you enter are used only to put the prompt together in your browser. They are never sent to a server.</p>
    <h2>Analytics</h2>
    <p>This site doesn't use cookies or tracking scripts. The host keeps standard request logs.</p>
    <h2>Claude</h2>
    <p>When you paste a prompt into Claude, Anthropic's own privacy policy applies to that chat.</p>
    <h2>Contact</h2>
    {SITE.contact
      ? <p>Questions: <a href={`mailto:${SITE.contact}`}>{SITE.contact}</a>.</p>
      : <p>Questions? Send {SITE.maker} a DM: {SITE.socials.map((s, i) => <>{i > 0 && ' or '}<a href={s.url} rel="me noopener" target="_blank">{s.label}</a></>)}.</p>}
  </section>
</Base>
