---
import Base from '../layouts/Base.astro';
import { STYLES, frameUrl } from '../data/styles';
import { SITE } from '../lib/site';
import Follow from '../components/Follow.astro';

const style = STYLES[0];
const issueNo = String(style.issue).padStart(2, '0');
const steps = [
  { title: 'Pick an issue', text: `Each issue is one animation style, printed with its sample. Issue ${issueNo} is ${style.name}.`, frame: 4 },
  { title: 'Write your topic', text: 'A topic, a few bullet points or your whole script. Add your own voiceover if you have one.', frame: 6 },
  { title: 'Copy one prompt', text: 'One button copies the style rules, your topic and the full animation code.', frame: 13 },
  { title: 'Paste it into Claude', text: 'Claude sketches a storyboard, you approve it, then it draws every frame with its sound.', frame: 23 },
];
const faq = [
  ['What is this?', `${SITE.name} is a free library of animation styles. Each issue is a complete animation drawn in code, with its own synthesized sound, plus the rules for rebuilding it around any topic.`],
  ['What do I need?', 'A Claude account. The prompt is long (about 60 KB), so a paid plan handles it most reliably; on a free plan, keep your topic short.'],
  ['Does it cost anything?', 'No. The styles and prompts are free, and there is nothing to sign up for.'],
  ['How do I get an MP4?', 'In a Claude chat the animation plays in your browser, sound included. To save it as an MP4, run the same prompt in Claude Code: the prompt carries the render steps.'],
  ['Can I use my own voiceover?', 'Yes. Choose "With voiceover" before you copy, then attach your recording in Claude. Every word on screen is timed to when you say it.'],
  ['Can I post the videos, even for clients?', 'Yes. What you make is yours. Please don\'t resell or republish the prompts themselves as a pack.'],
  ['Does it work in other languages?', 'Write your topic in any language. The Paper Cut fonts cover Latin scripts; for others, ask Claude to switch to a font that supports yours.'],
  ['Is what I type sent anywhere?', 'No. The prompt is put together in your browser, and your topic never reaches a server.'],
  ['Can I make my own style?', 'Yes. "Make your own" turns one to three screenshots of a look you like into a new style.'],
];
---
<Base>
  <!-- first viewport: one ink owns the whole print -->
  <section class="cover halftone" aria-labelledby="cover-title">
    <h1 id="cover-title" class="cover-title"><span class="over" data-echo={SITE.name}>{SITE.name}</span><span class="visually-hidden">: animation styles for Claude</span></h1>
    <div class="cover-body">
      <figure class="print" data-feed>
        <span class="staple s1" aria-hidden="true"></span><span class="staple s2" aria-hidden="true"></span>
        <video src={`/styles/${style.id}/media/sample.mp4`} poster={`/styles/${style.id}/media/poster.jpg`} width="1280" height="720" autoplay muted loop playsinline aria-label={`${style.name} sample, made from one prompt`}></video>
        <figcaption><span>Issue {issueNo} · {style.name}</span><span>made from one prompt</span></figcaption>
      </figure>
      <div class="offer">
        <p class="offer-line">Animation styles for Claude. One prompt, one video, sound included. <strong>Free.</strong></p>
        <div class="offer-act">
          <a class="btn" href={`/styles/${style.id}#prompt`}>Get Issue {issueNo}: {style.name}</a>
          <a class="offer-link" href="#how">How it works</a>
        </div>
      </div>
    </div>
    <ol class="issue-strip" aria-label="Issues">
      <li><b>Issue {issueNo}</b> {style.name} <span>out now</span></li>
      <li class="next"><b>Issue 02</b> <span>next month</span></li>
    </ol>
  </section>

  <!-- Issue 01 as an open zine spread -->
  <section id="issues" class="spread wrap" aria-labelledby="issue-title">
    <div class="spread-page left" data-feed>
      <img src={frameUrl(style, 29)} width="960" height="540" alt={`${style.name}: the closing frame, "Small steps. Big days." with a rubber stamp`} loading="lazy" />
      <img src={frameUrl(style, 23)} width="960" height="540" alt={`${style.name}: a paper clock sweeping ten minutes`} loading="lazy" class="tuck" />
    </div>
    <div class="spread-page right" data-feed style="--i:1">
      <h2 id="issue-title"><span class="over" data-echo={style.name} style={`--echo:${style.inks.echo}`}>{style.name}</span></h2>
      <p class="spread-lede">{style.tagline}</p>
      <p>{style.howItExplains}</p>
      <ul class="spread-facts small">
        <li><b>Issue {issueNo}</b> out now; Issue 02 next month</li>
        <li><b>Good for</b> {style.bestFor.join(', ')}</li>
        <li><b>Sound</b> kalimba bed and paper effects, synthesized in code</li>
      </ul>
      <a class="btn" href={`/styles/${style.id}#prompt`}>Get Issue {issueNo}</a>
    </div>
  </section>

  <!-- how it works: the print run, in order -->
  <section id="how" class="run wrap" aria-labelledby="how-title">
    <h2 id="how-title" data-feed>The print run</h2>
    <ol class="run-steps">
      {steps.map((s, i) => (
        <li data-feed style={`--i:${i}`}>
          <img src={frameUrl(style, s.frame)} width="960" height="540" alt="" loading="lazy" />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- every frame, printed on the yellow drum -->
  <section class="sheet halftone" aria-labelledby="sheet-title">
    <div class="sheet-head wrap">
      <h2 id="sheet-title" data-feed>Every frame</h2>
      <p class="sheet-note" data-feed style="--i:1">All {style.frames} frames of Issue {issueNo}, straight off the press. Each one was drawn in code, not edited.</p>
    </div>
    <div class="sheet-grid wrap">
      {Array.from({ length: style.frames }, (_, i) => <img src={frameUrl(style, i)} width="960" height="540" alt="" loading="lazy" />)}
    </div>
  </section>

  <!-- questions, set as the zine's colophon -->
  <section id="faq" class="faq wrap" aria-labelledby="faq-title">
    <h2 id="faq-title" data-feed>Questions</h2>
    <div class="faq-text">
      {faq.map(([q, a]) => <p><strong>{q}</strong> {a}</p>)}
    </div>
  </section>

  <section class="close wrap" aria-labelledby="close-title">
    <div class="close-print halftone" data-feed>
      <h2 id="close-title"><span class="over" data-echo="One prompt." style="--echo:var(--yellow)">One prompt.</span><br />One video.</h2>
      <div class="close-act">
        <p>Issue 02 is on the press. Take Issue {issueNo} today.</p>
        <a class="btn" href={`/styles/${style.id}#prompt`}>Get Issue {issueNo}: {style.name}</a>
        <Follow />
      </div>
    </div>
  </section>
</Base>

<style>
  /* cover */
  .cover { background-color: var(--pink); margin-top: -2px; padding: 0 var(--m) 0; min-height: calc(100svh - 80px); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; }
  .cover-title { font-size: var(--t-giant); line-height: .78; color: var(--blue); letter-spacing: -0.015em; margin: clamp(8px, 2vh, 24px) 0 0 -0.04em; mix-blend-mode: multiply; }
  .cover-title .over { --echo: var(--yellow); }
  .cover-body { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(20px, 3vh, 40px); }
  .print { margin: 0; background: #fbf8f1; padding: 12px 12px 0; box-shadow: var(--shadow-print); transform: rotate(-1.5deg); position: relative; }
  .print video { width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--paper-2); }
  .print figcaption { display: flex; justify-content: space-between; gap: 12px; padding: 10px 2px 12px; font-size: var(--t-small); font-weight: 600; }
  .print figcaption span:last-child { color: var(--pink-deep); }
  .offer { display: grid; gap: 28px; }
  .offer-line { font: 700 clamp(26px, 2.6vw, 40px)/1.12 var(--display); font-stretch: 85%; color: var(--ink); max-width: 18ch; }
  .offer-line strong { color: var(--paper); background: var(--ink); padding: 0 .15em; font-weight: 800; }
  .offer-act { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .offer-link { font-weight: 700; text-decoration-color: var(--ink); }
  .issue-strip li { white-space: nowrap; }
  .issue-strip { list-style: none; margin: 0 calc(var(--m) * -1); padding: 14px var(--m); display: flex; flex-wrap: wrap; gap: 8px 40px; background: var(--ink); color: var(--paper); font-size: var(--t-small); }
  .issue-strip b { font-family: var(--display); font-stretch: 80%; text-transform: uppercase; font-size: 18px; margin-right: 8px; }
  .issue-strip li span { color: var(--yellow); margin-left: 8px; }
  .issue-strip .next { color: #b8b1a4; }
  .issue-strip .next span { color: #b8b1a4; }
  @media (max-width: 900px) {
    .cover { min-height: 0; }
    .cover-body { grid-template-columns: 1fr; }
    .print { transform: rotate(-1deg); }
  }

  /* spread */
  .spread { display: grid; grid-template-columns: 1fr 1fr; margin-top: var(--gap-section); background: #fbf8f1; box-shadow: var(--shadow-print); margin-inline: var(--m); padding: 0; position: relative; }
  .spread::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: linear-gradient(rgba(26,26,26,.18), rgba(26,26,26,.05)); }
  .spread-page { padding: clamp(28px, 4vw, 64px); position: relative; }
  .spread-page.left { display: grid; gap: 0; align-content: center; }
  .spread-page.left img { width: 100%; height: auto; }
  .spread-page.left .tuck { width: 62%; margin: -14% 0 0 auto; box-shadow: var(--shadow-print); border: 8px solid #fbf8f1; transform: rotate(2deg); }
  .spread h2 { margin: 0 0 22px; font-size: clamp(64px, 8vw, 140px); line-height: .82; }
  .spread-lede { font: 700 var(--t-h3)/1.2 var(--display); font-stretch: 90%; margin-bottom: 16px; }
  .spread-page.right > p:not(.issue-no):not(.spread-lede) { max-width: 52ch; }
  .spread-facts { list-style: none; padding: 0; margin: 22px 0 30px; display: grid; gap: 6px; }
  .spread-facts b { font-weight: 700; margin-right: 6px; }
  @media (max-width: 900px) { .spread { grid-template-columns: 1fr; } .spread::after { display: none; } }

  /* print run */
  .run { margin-top: var(--gap-section); }
  .run h2 { max-width: 10ch; }
  .run-steps { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 28px); counter-reset: run; }
  .run-steps li { counter-increment: run; position: relative; padding-top: 64px; }
  .run-steps li::before { content: counter(run); position: absolute; top: 0; left: 0; font: 800 64px/1 var(--display); font-stretch: 75%; color: var(--pink); mix-blend-mode: multiply; }
  .run-steps img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; box-shadow: var(--shadow-print); border: 8px solid #fbf8f1; margin-bottom: 18px; }
  .run-steps li:nth-child(odd) img { transform: rotate(-1deg); }
  .run-steps li:nth-child(even) img { transform: rotate(1.2deg); }
  .run-steps h3 { font-size: clamp(26px, 2.2vw, 34px); margin-bottom: 8px; }
  .run-steps p { color: var(--ink-soft); }
  @media (max-width: 1000px) { .run-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .run-steps { grid-template-columns: 1fr; } }

  /* contact sheet on the yellow drum */
  .sheet { background-color: var(--yellow); margin-top: var(--gap-section); padding-block: clamp(56px, 7vw, 104px); }
  .sheet-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 36px; }
  .sheet-note { max-width: 36ch; font-weight: 600; }
  .sheet-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .sheet-grid img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; box-shadow: 0 1px 2px rgba(0,0,0,.2); transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .sheet-grid img:hover { transform: scale(1.08) rotate(-1deg); position: relative; z-index: 2; box-shadow: var(--shadow-print); }
  @media (max-width: 760px) { .sheet-grid { grid-template-columns: repeat(3, 1fr); } }

  /* colophon questions */
  .faq { display: grid; grid-template-columns: 4fr 8fr; gap: 40px; margin-top: var(--gap-section); }
  .faq-text { columns: 2; column-gap: 48px; }
  .faq-text p { break-inside: avoid; margin-bottom: 20px; }
  .faq-text strong { font: 800 22px/1.05 var(--display); font-stretch: 80%; text-transform: uppercase; display: block; margin-bottom: 4px; }
  @media (max-width: 900px) { .faq { grid-template-columns: 1fr; } .faq-text { columns: 1; } }

  /* close */
  .close { margin-top: var(--gap-section); }
  .close-print { background-color: var(--pink); padding: clamp(36px, 6vw, 88px); display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: end; box-shadow: var(--shadow-print); }
  .close-print h2 { font-size: clamp(64px, 9vw, 160px); line-height: .82; color: var(--blue); mix-blend-mode: multiply; }
  .close-act { display: grid; gap: 22px; justify-items: start; }
  .close-act a:not(.btn) { font-weight: 700; text-decoration-color: var(--ink); } /* pink underline vanishes on the pink field */
  .close-act p { font: 700 var(--t-h3)/1.2 var(--display); font-stretch: 90%; }
  @media (max-width: 900px) { .close-print { grid-template-columns: 1fr; } }
</style>
