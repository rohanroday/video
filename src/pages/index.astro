---
import Base from '../layouts/Base.astro';
import { STYLES } from '../data/styles';
import { SITE } from '../lib/site';
import Follow from '../components/Follow.astro';

const no = (n: number) => String(n).padStart(2, '0');
const latest = STYLES[STYLES.length - 1];
const nextIssue = no(latest.issue + 1);
// pictures come from scripts/render-steps.mjs: real captures of this site for 1-3, a drawn chat for 4
const steps = [
  { title: 'Pick an issue', text: 'Each issue is one animation style, printed with its sample video and every frame.', img: '/steps/step-1.jpg', alt: 'The Paper Cut issue card on the shelf' },
  { title: 'Write your topic', text: 'A topic, a few bullet points or your whole script. Pick an AI voice, or use your own recording.', img: '/steps/step-2.jpg', alt: 'The order slip with "How to start running" typed in, and its paper title card' },
  { title: 'Copy one prompt', text: 'One button copies the style rules, your topic and the full animation code.', img: '/steps/step-3.jpg', alt: 'The Copy button just after a copy, with the stamped "Copied 58 KB" print' },
  { title: 'Paste it into Claude', text: 'Claude sketches a storyboard, you approve it, then it draws every frame with its sound.', img: '/steps/step-4.jpg', alt: 'Illustration of a chat: the pasted prompt, then a four-beat storyboard with an Approve button' },
];
const faq = [
  ['What is this?', `${SITE.name} is a free library of animation styles. Each issue is a complete animation drawn in code, with its own synthesized sound, plus the rules for rebuilding it around any topic.`],
  ['What do I need?', 'A Claude account. The prompt is long (about 60 KB), so a paid plan handles it most reliably; on a free plan, keep your topic short.'],
  ['Does it cost anything?', 'No. The styles and prompts are free, and there is nothing to sign up for.'],
  ['How do I get an MP4?', 'In a Claude chat the animation plays in your browser, sound included. To save it as an MP4, run the same prompt in Claude Code: the prompt carries the render steps.'],
  ['No voiceover? Use an AI voice.', 'Choose "AI voice" (female or male) before you copy. Claude writes a short script for your OK, and the video narrates it with a natural text-to-speech voice, timed to the words on screen. With Claude Code, the voice can be saved into the MP4 too.'],
  ['Can I use my own voiceover?', 'Yes. Choose "My own voiceover" before you copy, then attach your recording in Claude. Every word on screen is timed to when you say it.'],
  ['Can I post the videos, even for clients?', 'Yes. What you make is yours. Please don\'t resell or republish the prompts themselves as a pack.'],
  ['Does it work in other languages?', 'Write your topic in any language. If a style\'s fonts don\'t cover your script, ask Claude to switch to one that does.'],
  ['Is what I type sent anywhere?', 'No. The prompt is put together in your browser, and your topic never reaches a server.'],
  ['Can I make my own style?', 'Yes. "Make your own" turns one to three screenshots of a look you like into a new style.'],
];
---
<Base>
  <!-- first viewport: one ink owns the whole print, sized to the window's height as well as its width -->
  <section class="cover halftone" aria-labelledby="cover-title">
    <h1 id="cover-title" class="cover-title"><span class="over" data-echo={SITE.name}>{SITE.name}</span><span class="visually-hidden">: animation styles for Claude</span></h1>
    <div class="cover-body">
      <figure class="print">
        <span class="staple s1" aria-hidden="true"></span><span class="staple s2" aria-hidden="true"></span>
        <video src={`/styles/${latest.id}/media/sample.mp4`} poster={`/styles/${latest.id}/media/poster.jpg`} width="1280" height="720" autoplay muted loop playsinline aria-label={`${latest.name} sample, made from one prompt`}></video>
        <figcaption><span>Issue {no(latest.issue)} · {latest.name}</span><span>made from one prompt</span></figcaption>
      </figure>
      <div class="offer">
        <p class="offer-line">Animation styles for Claude. One prompt, one video, sound included. <strong>Free.</strong></p>
        <div class="offer-act">
          <a class="btn" href="#issues">Browse the issues</a>
          <a class="offer-link" href="#how">How it works</a>
        </div>
      </div>
    </div>
    <ol class="issue-strip" aria-label="Issues">
      {STYLES.map((s) => <li><a href={`/styles/${s.id}`}><b>Issue {no(s.issue)}</b> {s.name}</a> <span>out now</span></li>)}
      <li class="next"><b>Issue {nextIssue}</b> <span>on the press</span></li>
    </ol>
  </section>

  <!-- the shelf: one card per issue; it grows as new styles are printed -->
  <section id="issues" class="shelf wrap" aria-labelledby="issues-title">
    <div class="shelf-head">
      <h2 id="issues-title" data-feed>The issues</h2>
      <p data-feed style="--i:1">Every issue is one original animation style. Open one, write your topic, and copy its prompt.</p>
    </div>
    <ul class="shelf-grid">
      {STYLES.map((s, i) => (
        <li class="zine" style={`--field:${s.inks.field}; --echo:${s.inks.echo}`} data-feed>
          <a class="zine-link" href={`/styles/${s.id}`} aria-labelledby={`zine-${s.id}`}>
            <span class="zine-cover halftone">
              <img src={`/styles/${s.id}/media/poster.jpg`} width="1280" height="720" alt="" loading={i < 3 ? 'eager' : 'lazy'} />
            </span>
            <span class="zine-title" id={`zine-${s.id}`}><span class="zine-no">{no(s.issue)}</span> {s.name}</span>
            <span class="zine-tag">{s.tagline}</span>
            <span class="zine-meta small">{s.family} · {s.bestFor.slice(0, 2).join(', ')}</span>
          </a>
        </li>
      ))}
      <li class="zine next" data-feed>
        <div class="zine-cover blank" aria-hidden="true"><span>{nextIssue}</span></div>
        <p class="zine-title"><span class="zine-no">{nextIssue}</span> On the press</p>
        <p class="zine-tag">A new original style lands every month.</p>
        <Follow lead={`Follow for Issue ${nextIssue}`} />
      </li>
    </ul>
  </section>

  <!-- how it works: the print run, in order -->
  <section id="how" class="run wrap" aria-labelledby="how-title">
    <h2 id="how-title" data-feed>The print run</h2>
    <ol class="run-steps">
      {steps.map((s, i) => (
        <li data-feed style={`--i:${i}`}>
          <img src={s.img} width="1200" height="900" alt={s.alt} loading="lazy" />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- questions, set as the zine's colophon -->
  <section id="faq" class="faq wrap" aria-labelledby="faq-title">
    <h2 id="faq-title" data-feed>Questions</h2>
    <div class="faq-text">
      {faq.map(([q, a]) => <p><strong>{q}</strong> {a}</p>)}
    </div>
  </section>

  <section class="close wrap" aria-labelledby="close-title">
    <div class="close-print halftone" data-feed>
      <h2 id="close-title"><span class="over" data-echo="One prompt." style="--echo:var(--yellow)">One prompt.</span><br />One video.</h2>
      <div class="close-act">
        <p>Issue {nextIssue} is on the press. Take Issue {no(latest.issue)} today.</p>
        <a class="btn" href={`/styles/${latest.id}#prompt`}>Get Issue {no(latest.issue)}: {latest.name}</a>
        <Follow lead={`Follow for Issue ${nextIssue}`} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* cover: title, print and offer all inside one window, whatever its height */
  .cover {
    --fs: clamp(64px, min(24vw, 25svh), 380px);
    background-color: var(--pink); margin-top: -2px; padding: 0 var(--pad);
    min-height: calc(100svh - 76px); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden;
  }
  .cover-title { font-size: var(--fs); line-height: .78; color: var(--blue); letter-spacing: -0.015em; margin: clamp(6px, 1.6svh, 20px) 0 0 -0.04em; mix-blend-mode: multiply; }
  .cover-title .over { --echo: var(--yellow); }
  .cover-body { display: grid; grid-template-columns: auto minmax(260px, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(14px, 2.4svh, 32px); min-height: 0; }
  /* the print is as wide as the leftover height allows (16:9 plus its caption), never wider than 60% of the page */
  .print { margin: 0; background: #fbf8f1; padding: 10px 10px 0; box-shadow: var(--shadow-print); transform: rotate(-1.2deg); position: relative;
    width: clamp(280px, calc((100svh - 76px - var(--fs) * .8 - 48px - 120px) * 1.62), 60vw); }
  .print video { width: 100%; aspect-ratio: 16 / 9; background: var(--paper-2); }
  .print figcaption { display: flex; justify-content: space-between; gap: 12px; padding: 8px 2px 10px; font-size: var(--t-small); font-weight: 600; }
  .print figcaption span:last-child { color: var(--pink-deep); }
  .print { container-type: inline-size; }
  @container (max-width: 440px) { .print figcaption span:last-child { display: none; } } /* a small print keeps one caption line */
  .offer { display: grid; gap: clamp(16px, 2.6svh, 28px); }
  .offer-line { font: 700 clamp(24px, min(2.6vw, 4.2svh), 44px)/1.12 var(--display); font-stretch: 85%; color: var(--ink); max-width: 18ch; }
  .offer-line strong { color: var(--paper); background: var(--ink); padding: 0 .15em; font-weight: 800; }
  .offer-act { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .offer-link { font-weight: 700; text-decoration-color: var(--ink); }
  .issue-strip { list-style: none; margin: 0 calc(var(--pad) * -1); padding: 12px var(--pad); display: flex; flex-wrap: wrap; gap: 8px 40px; background: var(--ink); color: var(--paper); font-size: var(--t-small); }
  .issue-strip li { white-space: nowrap; }
  .issue-strip a { text-decoration: none; }
  .issue-strip a:hover { text-decoration: underline; }
  .issue-strip b { font-family: var(--display); font-stretch: 80%; text-transform: uppercase; font-size: 18px; margin-right: 8px; }
  .issue-strip li span { color: var(--yellow); margin-left: 8px; }
  .issue-strip .next, .issue-strip .next span { color: #b8b1a4; }
  @media (max-width: 900px) {
    .cover { --fs: clamp(64px, 24vw, 200px); min-height: 0; }
    .cover-body { grid-template-columns: 1fr; }
    .print { width: 100%; transform: rotate(-1deg); }
  }

  /* shelf of issues: one card each, columns fill as issues are added */
  .shelf { margin-top: var(--gap-section); }
  .shelf-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 40px; margin-bottom: clamp(32px, 4vw, 56px); }
  .shelf-head p { max-width: 38ch; font: 700 var(--t-h3)/1.25 var(--display); font-stretch: 90%; }
  .shelf-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: clamp(24px, 3vw, 44px); }
  .shelf-grid:has(> li:nth-child(3)) { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .zine { display: grid; align-content: start; }
  .zine-link { display: grid; gap: 10px; text-decoration: none; color: inherit; }
  .zine-cover { display: block; background-color: var(--field); padding: clamp(14px, 2vw, 26px); box-shadow: var(--shadow-print); margin-bottom: 8px; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
  .zine-cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 8px solid #fbf8f1; transform: rotate(-1.5deg); transition: transform .35s var(--ease); }
  .zine-link:hover .zine-cover { transform: translateY(-4px) rotate(-.6deg); box-shadow: 0 2px 2px rgba(26,26,26,.12), 0 22px 34px -12px rgba(26,26,26,.35); }
  .zine-link:hover .zine-cover img { transform: rotate(0deg); }
  .zine-link:focus-visible { outline-offset: 6px; }
  .zine-title { font: 800 clamp(34px, 3.2vw, 52px)/.9 var(--display); font-stretch: 75%; text-transform: uppercase; margin: 0; }
  .zine-no { color: var(--echo, var(--pink-deep)); margin-right: .12em; }
  .zine-tag { font: 700 var(--t-h3)/1.2 var(--display); font-stretch: 90%; margin: 0; }
  .zine-meta { color: var(--ink-soft); }
  .zine.next .zine-cover.blank { aspect-ratio: auto; display: grid; place-items: center; min-height: 0; background: transparent; box-shadow: none; outline: 3px dashed rgba(26,26,26,.28); outline-offset: -3px; }
  .zine.next .zine-cover.blank::before { content: ''; display: block; width: 100%; aspect-ratio: 16 / 9; grid-area: 1 / 1; }
  .zine.next .zine-cover.blank span { grid-area: 1 / 1; font: 800 clamp(80px, 9vw, 150px)/1 var(--display); font-stretch: 75%; color: var(--pink); mix-blend-mode: multiply; opacity: .55; }
  .zine.next .zine-title, .zine.next .zine-tag { color: var(--ink-soft); }
  .zine.next .follow { margin-top: 10px; }

  /* print run */
  .run { margin-top: var(--gap-section); }
  .run-steps { list-style: none; margin: clamp(32px, 4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 28px); counter-reset: run; }
  .run-steps li { counter-increment: run; position: relative; padding-top: 64px; }
  .run-steps li::before { content: counter(run); position: absolute; top: 0; left: 0; font: 800 64px/1 var(--display); font-stretch: 75%; color: var(--pink); mix-blend-mode: multiply; }
  .run-steps img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; box-shadow: var(--shadow-print); border: 8px solid #fbf8f1; margin-bottom: 18px; }
  .run-steps li:nth-child(odd) img { transform: rotate(-1deg); }
  .run-steps li:nth-child(even) img { transform: rotate(1.2deg); }
  .run-steps h3 { font-size: clamp(26px, 2.2vw, 34px); margin-bottom: 8px; }
  .run-steps p { color: var(--ink-soft); }
  @media (max-width: 1000px) { .run-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .run-steps { grid-template-columns: 1fr; } }

  /* colophon questions */
  .faq { display: grid; grid-template-columns: 4fr 8fr; gap: 40px; margin-top: var(--gap-section); }
  .faq-text { columns: 2; column-gap: 48px; }
  .faq-text p { break-inside: avoid; margin-bottom: 20px; }
  .faq-text strong { font: 800 22px/1.05 var(--display); font-stretch: 80%; text-transform: uppercase; display: block; margin-bottom: 4px; }
  @media (max-width: 900px) { .faq { grid-template-columns: 1fr; } .faq-text { columns: 1; } }

  /* close */
  .close { margin-top: var(--gap-section); }
  .close-print { background-color: var(--pink); padding: clamp(36px, 6vw, 88px); display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: end; box-shadow: var(--shadow-print); }
  .close-print h2 { font-size: clamp(64px, 8vw, 150px); line-height: .82; color: var(--blue); mix-blend-mode: multiply; }
  .close-act { display: grid; gap: 22px; justify-items: start; }
  .close-act p { font: 700 var(--t-h3)/1.2 var(--display); font-stretch: 90%; }
  .close-act a:not(.btn) { font-weight: 700; text-decoration-color: var(--ink); } /* pink underline vanishes on the pink field */
  @media (max-width: 900px) { .close-print { grid-template-columns: 1fr; } }
</style>
