---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/schibsted-grotesk';
import '../css/global.css';
import { SITE } from '../lib/site';
import { STYLES } from '../data/styles';
import Follow from '../components/Follow.astro';

interface Props { title?: string; description?: string; image?: string }
const { title, description = SITE.description, image = '/styles/paper-cut/media/poster.jpg' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: animation styles for Claude`;
const first = STYLES[0];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="theme-color" content="#ff48b0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="bar">
      <a class="wordmark" href="/">{SITE.name}</a>
      <nav aria-label="Main">
        <a class="hide-sm" href="/#issues">Issues</a>
        <a class="hide-sm" href="/#how">How it works</a>
        <a class="hide-xs" href="/make-your-own">Make your own</a>
        <a class="btn" href={`/styles/${first.id}#prompt`}>Get Issue 01</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <p class="colophon-name" aria-hidden="true">{SITE.name}<span>.</span></p>
      <div>
        <p>Animation styles drawn in code and printed for Claude. Free, no sign-up.</p>
        <p class="fine" style="margin-top:10px">Printed in code by {SITE.maker}. © {SITE.year}.</p>
        <div style="margin-top:24px"><Follow /></div>
      </div>
      <ul aria-label="Footer">
        <li><a href="/#issues">Issues</a></li>
        <li><a href="/make-your-own">Make your own</a></li>
        <li><a href="/#faq">Questions</a></li>
      </ul>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/license">License</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </footer>
    <script>
      // each section's print feeds in once as it scrolls into view
      const items = document.querySelectorAll<HTMLElement>('[data-feed]');
      const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
